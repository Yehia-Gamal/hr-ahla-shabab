# HR Ahla Shabab — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env or .env.local to git.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
SUPABASE_PROJECT_REF=your_project_ref_here

# VAPID keys for Web Push notifications
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

# GitHub (for CI/CD only — never commit real tokens)
GITHUB_TOKEN=your_github_token_here

# Database (for local tooling only)
DB_PASSWORD=your_db_password_here

# Rate limiting salt (optional, defaults to service key prefix)
LOGIN_RATE_LIMIT_SALT=your_salt_here
